{
  "manifest_version": 3,
  "name": "TPO Company Alerter",
  "version": "1.1",
  "description": "Get notified when new companies are listed on TPO portal.",
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "scripting",
    "tabs",
    "notifications"
  ],
  "host_permissions": ["https://tpo.vierp.in/*", "http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://tpo.vierp.in/*"],
      "js": ["content.js"]
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["widget.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  }
}
